OPENROUTER_API_KEY=your_openrouter_key_here

LLM_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,qwen/qwen3.8-27b:free,inclusionai/ling-3.1-flash

LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2

# Optional LM Studio fallback for OpenRouter rate limits or provider outages.
# Download/load the Qwen2.5 1.5B Instruct GGUF model in LM Studio and start its server.
# Localhost model servers are not reachable from Streamlit Community Cloud.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=lmstudio-community/Qwen2.5-1.5B-Instruct-GGUF

ENVIRONMENT=development
DEBUG=true

QDRANT_COLLECTION=storyforge

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

RETRIEVAL_TOP_K=5

CHUNK_SIZE=800
CHUNK_OVERLAP=120